{
	"schemaVersion": 1,
	"id": "early-loading-screen",
	"version": "${version}",
	"name": "Fabric Early Loading Screen",
	"description": "A port of the mod (Neo)Forge Early Loading Screen for Fabric to later versions",
	"authors": [
		"XDPXI",
		"Jab125"
	],
	"contributors": [
		"NeoForged Team",
		"MinecraftForge Team"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/fels",
		"sources": "https://github.com/XDPXI/fabric-early-loading-screen",
		"issues": "https://github.com/XDPXI/fabric-early-loading-screen/issues"
	},
	"license": "LGPL-2.1-only",
	"icon": "assets/early-loading-screen/icon.png",
	"environment": "client",
	"entrypoints": {
		"early-loading-screen-hook-provider": [
			"com.jab125.earlyloadingscreen.util.Provider"
		]
	},
	"mixins": [
		"early-loading-screen.mixins.json",
		"early-loading-screen-plugin.mixins.json"
	],
	"languageAdapters": {
		"els-asddsjkh": "com.jab125.earlyloadingscreen.util.HooksLaInit"
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": [
			">=26.1 <26.2-",
			">=26.2 <26.3-"
		],
		"java": ">=25"
	},
	"breaks": {
		"quilt_loader": "*",
		"springboard": "*"
	},
	"custom": {
		"sodium:options": {
			"mixin.workarounds.context_creation": false
		},
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/s2AtrCEKCn",
				"modmenu.kofi": "https://ko-fi.com/Jab125/"
			}
		}
	}
}
